# Opcional: sem esta chave, o LogiPilot gera um diagnóstico local a partir da
# série numérica encontrada nos arquivos, sem IA.
GROQ_API_KEY=sua_chave_da_groq_aqui

# Modelo usado para ler prints e fotos. Precisa aceitar imagem.
# GROQ_MODELO_VISAO=qwen/qwen3.8-27b

# Quantos caracteres de dados são enviados à IA por análise.
# Aumente se a sua conta da Groq tiver um limite de tokens por minuto maior.
# LIMITE_CARACTERES_IA=15000

# PORT=3333
